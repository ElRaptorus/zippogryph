{
  "name": "@elraptorus/zippogryph",
  "version": "1.0.1",
  "description": "Lightweight extraction tool for zip archives.",
  "keywords": [
    "zip",
    "node",
    "typescript",
    "extract-zip"
  ],
  "homepage": "https://github.com/ElRaptorus/zippogryph#readme",
  "bugs": {
    "url": "https://github.com/ElRaptorus/zippogryph/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElRaptorus/zippogryph.git"
  },
  "license": "MIT",
  "author": "ElRaptorus",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "zippogryph": "dist/cli.js",
    "extract-zip": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=12.0.0"
  },
  "allowScripts": {
    "fsevents": false
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint --fix src/ test/",
    "format": "prettier --write --config .prettierrc.json src test *.json *.md",
    "format:check": "prettier --check --config .prettierrc.json src test *.json *.md",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
